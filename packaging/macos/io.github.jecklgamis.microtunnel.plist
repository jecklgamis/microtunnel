<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.jecklgamis.microtunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/microtunnel</string>
		<string>-c</string>
		<string>/etc/microtunnel/microtunnel.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/etc/microtunnel/microtunnel.yaml</key>
			<true/>
		</dict>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/log/microtunnel.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/microtunnel.log</string>
</dict>
</plist>

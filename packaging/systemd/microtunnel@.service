[Unit]
Description=Microtunnel (%i)
Documentation=https://github.com/jecklgamis/microtunnel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/microtunnel/%i.yaml

[Service]
# One instance per config, for machines in more than one overlay or running several tunnels:
# `systemctl enable --now microtunnel@home` runs /etc/microtunnel/home.yaml
# (`microtunnel init peer --name home`, or `join` for a token named "home"). Give each
# config its own `interface:` name.
ExecStart=/usr/bin/microtunnel -c /etc/microtunnel/%i.yaml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN
# Per-instance runtime dir (admin socket: /run/microtunnel-%i/admin.sock).
RuntimeDirectory=microtunnel-%i
RuntimeDirectoryMode=0750

# Sandboxing. The daemon needs only the TUN device, UDP/UNIX sockets and netlink
# (for the `ip` commands it runs), and writes only its peers directory.
# If peers_dir points outside /etc/microtunnel, add that path to ReadWritePaths.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/microtunnel
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

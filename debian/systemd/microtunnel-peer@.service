[Unit]
Description=Microtunnel - Peer %i
After=network-online.target
Wants=network-online.target

[Service]
# One instance per config: `systemctl enable --now microtunnel-peer@laptop` runs
# /etc/microtunnel/laptop.yaml (as written by `microtunnel init peer -name laptop` or `join`).
ExecStart=/usr/bin/microtunnel -c /etc/microtunnel/%i.yaml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target

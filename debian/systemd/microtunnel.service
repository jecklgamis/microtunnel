[Unit]
Description=Microtunnel
Documentation=https://github.com/jecklgamis/microtunnel
After=network-online.target
Wants=network-online.target
# Not configured yet? Run `sudo microtunnel init relay` (or `init peer`) first.
ConditionPathExists=/etc/microtunnel/microtunnel.yaml

[Service]
# The same program is a relay or a peer: the config decides which.
ExecStart=/usr/bin/microtunnel -c /etc/microtunnel/microtunnel.yaml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN
# /run/microtunnel exists while the service runs: home of the admin socket
# (admin_socket: /run/microtunnel/admin.sock). Only root can reach it.
RuntimeDirectory=microtunnel
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
